# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL with pgvector support)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/medical_ai_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=medical_ai_db

# LLM & Embedding API Configuration
# Supported LLM providers: openai, google, anthropic, or local/ollama
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o

# Vector Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# n8n Orchestrator Integration
# URL of the n8n webhook receiving the document extraction/chat tasks
N8N_WEBHOOK_URL=http://localhost:5678/webhook/medical-report-agent
N8N_API_KEY=your_n8n_api_key_here
N8N_TIMEOUT_MS=60000

# Authentication & Session Security
SESSION_SECRET=your_super_secret_session_key_min_32_chars
JWT_SECRET=your_jwt_secret_key_change_in_production
BCRYPT_SALT_ROUNDS=12

# File Upload Constraints
MAX_FILE_SIZE_MB=15
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,image/jpg

# Vector Store / Agentic RAG Settings
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.65
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80

# Safety and Privacy
ENABLE_PII_REDACTION=true
ENABLE_EMERGENCY_OVERRIDE=true
